<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tsanet</groupId>
        <artifactId>tsanet-client-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>demo-ui</artifactId>
    <name>TSANet-demo-ui</name>
    <description>Branded web demo for connect-library, run against TSANet Connect BETA</description>

    <dependencies>
        <dependency>
            <groupId>com.tsanet</groupId>
            <artifactId>connect-library</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tsanet</groupId>
            <artifactId>connect-e2ee</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Stamps git.properties, which Spring Boot reads for /api/version. git-commit-id-maven-plugin
                 isn't used here: in a linked worktree, where the deploy recipe builds, it reads the main
                 clone's HEAD and stamps the wrong commit. Without a shell the version reads "unknown". -->
            <id>stamp-version</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>stamp-version</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>echo "git.commit.id.describe=$(git describe --tags --match 'v*' --always --dirty --abbrev=7 2>/dev/null)"; echo "git.commit.id.abbrev=$(git rev-parse --short=7 HEAD 2>/dev/null)"</argument>
                                    </arguments>
                                    <outputFile>${project.build.outputDirectory}/git.properties</outputFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
